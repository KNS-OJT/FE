# Every VITE_* variable is embedded in the public JS bundle. Never put secrets here.
VITE_API_BASE_URL=/api
VITE_DEV_PROXY_TARGET=http://localhost:8080
VITE_APP_NAME=Kho & Mua hàng
# true = show SIMULATED screens for features the backend has no API for yet (goods receipts).
# A warning banner is shown and real stock is never changed.
VITE_DEMO_MOCK_MISSING=true
